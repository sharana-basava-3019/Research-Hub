# ========================================
# PRODUCTION ENVIRONMENT VARIABLES - ANALYTICS SERVICE
# ========================================
# Copy these variables and set them in your Render Web Service environment dashboard.

FLASK_APP=app.py
FLASK_ENV=production

# MongoDB Connection (set in Render dashboard from your Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/research-hub?retryWrites=true&w=majority

# Analytics Settings
CACHE_EXPIRY=86400
MIN_SIMILARITY_SCORE=0.3
MAX_RECOMMENDATIONS=10
